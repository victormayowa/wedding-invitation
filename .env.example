# Copy to .env and fill in. Never commit the real .env file.

# Password for the admin area at /admin. Choose something long.
ADMIN_PASSWORD=

# Long random string used to sign cookies. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=

# The public address of the site, used in invitation links and link previews.
PUBLIC_URL=http://localhost:3000

# Postgres connection string. Without it, the site keeps its data in a SQLite file
# in DATA_DIR, which is convenient on your own computer.
#   DATABASE_URL=postgres://user:password@localhost:5432/wedding
DATABASE_URL=
# 'require' for TLS, or 'no-verify' for TLS with a self-signed certificate.
DATABASE_SSL=

# Where the SQLite file is kept when DATABASE_URL is not set.
DATA_DIR=./data

PORT=3000

# Set to 1 when running behind a reverse proxy or a host such as Render or Fly,
# so visitor IP addresses (used for rate limiting) are read correctly.
TRUST_PROXY=0

# Set to 1 to show content placeholders to every visitor (local design work only).
SHOW_PLACEHOLDERS=0

# Development only: pretend the current time is this, e.g. 2026-11-29T12:00:00+01:00,
# to preview how the site looks on or after the wedding day. Ignored in production.
NOW=
